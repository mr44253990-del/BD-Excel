<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bd_green"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/formatBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#F4F6F5">

        <ImageButton
            android:id="+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/undo" />

        <ImageButton
            android:id="+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_forward"
            android:contentDescription="@string/redo" />

        <TextView
            android:id="+id/btnBold"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="B"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#202124" />

        <TextView
            android:id="+id/btnItalic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="I"
            android:textStyle="italic"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#202124" />

        <ImageView
            android:id="+id/btnTextColor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_format_color_text"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Text color" />

        <ImageView
            android:id="+id/btnFillColor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_format_color_fill"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fill color" />

        <TextView
            android:id="+id/btnAlign"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="↦"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="#202124" />

        <ImageButton
            android:id="+id/btnInsertRow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_row_insert"
            android:contentDescription="Insert row" />

        <ImageButton
            android:id="+id/btnDeleteRow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_row_delete"
            android:contentDescription="Delete row" />

        <ImageButton
            android:id="+id/btnInsertCol"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_col_insert"
            android:contentDescription="Insert column" />

        <ImageButton
            android:id="+id/btnDeleteCol"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_col_delete"
            android:contentDescription="Delete column" />
    </LinearLayout>

    <com.bdexcel.app.view.SpreadsheetView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/cellRefView"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="A1"
                android:textStyle="bold"
                android:textColor="@color/bd_green" />

            <EditText
                android:id="@+id/formulaEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Value or =SUM(A1:A5)"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:singleLine="true" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sheetTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
